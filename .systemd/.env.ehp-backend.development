ehpNODE_ENV: production
ehpPORT: 1170
ehpDATABASE_URL: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}
ehpJWT_SECRET: ${JWT_SECRET:-change-me-very-secret}
ehpJWT_EXPIRES_IN: 1d
ehpJWT_REFRESH_EXPIRES_IN: 7d
ehpEMAIL_USER: ${EMAIL_USER}
ehpEMAIL_PASS: ${EMAIL_PASS}
ehpADMIN_USER: ${ADMIN_USER}
ehpADMIN_PASS: ${ADMIN_PASS}
ehpCLIENT_URL: https://node-dev.sabanciuniv.edu/ehp
