APP_NAME="E-Devlet İle Giriş"
APP_ENV=development
APP_KEY=$API_KEY
APP_DEBUG=false
API_PREFIX=api
APP_URL=https://node.sabanciuniv.edu/su-edevlet
APP_TIMEZONE=UTC

API_DATALOGGER=true

DB_CONNECTION=mysql
DB_HOST_MYSQL=suwebdb4.sabanciuniv.edu
DB_DATABASE_MYSQL=edevlet
DB_USERNAME_MYSQL=edevlet
DB_PASSWORD_MYSQL=$DB_PASSWORD

API_EDEVLET_CLIENT_ID=b80a78f1-34d9-468f-bbe4-a82915df886b
API_EDEVLET_CLIENT_SECRET=$EDEVLET_CLIENT_SECRET
API_EDEVLET_REDIRECT_URL=https://node.sabanciuniv.edu/su-edevlet/callback

CACHE_DRIVER=array
QUEUE_CONNECTION=array
