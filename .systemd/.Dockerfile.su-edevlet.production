# 1. Install dependencies only when needed
FROM igs.sabanciuniv.edu:5050/imagebase/images/nodejs-base AS deps
# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
#RUN apk add --no-cache libc6-compat
WORKDIR /app

#ENV npm_config_cache=/root/.npm on the preferred package manager
COPY package.json package-lock.json* ./

RUN npm config set fetch-retry-maxtimeout 60000 && \
    npm config set fetch-retries 20 && \
    npm ci --prefer-offline --cache /root/.npm && \
    npm install @next/swc-linux-x64-musl --no-save



# 2. Rebuild the source code only when needed.
FROM igs.sabanciuniv.edu:5050/imagebase/images/nodejs-base AS builder
WORKDIR /app

# Build-time public env vars (NEXT_PUBLIC_* are baked into the JS bundle at build time)
ARG NEXT_PUBLIC_BASE_PATH=/sumac
ARG NEXT_PUBLIC_API_URL=/sumac/api
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_CACHE_DIR=/ap
# Install dependencies based p/.next/cache

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* ./
# Selective copy of source code
COPY next.config.mjs jsconfig.json proxy.js ./
COPY public ./public
COPY app ./app
COPY lib ./lib
COPY components ./components
COPY styles ./styles
COPY certs ./certs

RUN cp /data/azure-saml-dev.crt /app/certs/azure-saml-dev.crt && \
    touch /data/test1.txt && \
    #   mkdir .next && \
    cat /app/certs/azure-saml-dev.crt && \
    chown node:node .next && \
    npm run build

# Next.js collects completely anonymous telemetry data about general usage.
# Learn more here: https://nextjs.org/telemetry
# Uncomment the following line in case you want to disable telemetry during the build.
# ENV NEXT_TELEMETRY_DISABLED 1

# 3. Production image, copy all the files and run next
#FROM dhi.io/igs.sabanciuniv.edu:5050/imagebase/images:$node_base3.22 AS runner

FROM igs.sabanciuniv.edu:5050/imagebase/images/nodejs-base AS runner
WORKDIR /app

RUN apk add curl

# 1. Aşama: Derleme (Builder)
FROM node:20-alpine AS builder
WORKDIR /app

ARG VITE_API_URL=/ehp/api
ARG VITE_BASE_PATH=/ehp
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npm run build

# 2. Aşama: Yayına Alma (Production)
FROM nginx:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8004

CMD ["nginx", "-g", "daemon off;"]
