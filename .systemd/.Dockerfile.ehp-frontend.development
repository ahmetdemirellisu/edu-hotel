# 1. Aşama: Derleme (Builder)
FROM igs.sabanciuniv.edu:5050/imagebase/images/nodejs-base-20 AS builder
WORKDIR /app

ARG VITE_API_URL=/ehp/api
ARG VITE_BASE_PATH=/ehp
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH

COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps

COPY frontend .
RUN npm run build

# 2. Aşama: Yayına Alma (Production)
FROM igs.sabanciuniv.edu:5050/imagebase/images/nginx-unprivileged-base

#COPY /.systemd/docker/nginx/nginx.conf /etc/nginx/nginx.conf

RUN rm /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 1170
