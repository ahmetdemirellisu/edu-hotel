generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  name         String?
  createdAt    DateTime      @default(now())
  role         UserRole      @default(USER)
  userType     UserType      @default(OTHER)
  firstName    String?
  lastName     String?
  phone           String?
  maxStayOverride Int?
  blacklist       Blacklist?
  reservations    Reservation[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Room {
  id           Int           @id @default(autoincrement())
  name         String
  type         String
  price        Int
  capacity     Int
  description  String
  image        String?
  amenities    String
  createdAt    DateTime      @default(now())
  status       RoomStatus    @default(AVAILABLE)
  reservations Reservation[]
}

model Reservation {
  id                Int               @id @default(autoincrement())
  userId            Int
  roomId            Int?
  roomIds           Json?
  checkIn           DateTime
  checkOut          DateTime
  guests            Int
  createdAt         DateTime          @default(now())
  accommodationType AccommodationType
  eventCode         String?
  invoiceType       InvoiceType
  note              String?
  status            ReservationStatus @default(PENDING)
  guestType         UserType          @default(OTHER)
  checkInTime       String?
  contactEmail      String?
  eventType         String?
  firstName         String?
  freeAccommodation Boolean           @default(false)
  guestList         Json?
  lastName          String?
  nationalId        String?
  phone             String?
  priceType         String?
  taxNumber         String?
  paymentStatus     PaymentStatus     @default(NONE)
  price             Float?
  billingTitle      String?
  billingAddress    String?
  identityDoc       String?
  adminNote         String?
  room              Room?             @relation(fields: [roomId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  identityDocuments IdentityDocument[]
}

model IdentityDocument {
  id            Int         @id @default(autoincrement())
  reservationId Int
  guestIndex    Int
  fileName      String
  mimeType      String
  sizeBytes     Int
  uploadedAt    DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, guestIndex])
}

model Blacklist {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  reason    String
  addedAt   DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

// Single-row table holding all admin-configurable hotel settings.
// Always read/write the row where id = 1.
model Settings {
  id                Int      @id @default(1)
  // Hotel identity
  hotelName         String   @default("EDU Hotel")
  contactEmail      String   @default("hotel@sabanciuniv.edu")
  contactPhone      String   @default("+90 (216) 483 9000")
  // Booking rules
  maxAdvanceDays    Int      @default(30)
  maxStayNights     Int      @default(5)
  autoApprove       Boolean  @default(false)
  // Notifications
  emailNotifications Boolean @default(true)
  // Banking (Payment page)
  bankName          String   @default("Akbank T.A.Ş.")
  accountHolder     String   @default("Sabtek A.Ş.")
  iban              String   @default("TR85 0004 6007 1388 8000 1139 89")
  // Guest-facing info
  checkInTime       String   @default("14:00")
  checkOutTime      String   @default("12:00")
  wifiSsid          String   @default("EDU-Hotel-Guest")
  wifiPassword      String   @default("Welcome2026")
  breakfastHours    String   @default("07:30 – 10:00")
  receptionHours    String   @default("24/7")
  // Bookkeeping
  updatedAt         DateTime @updatedAt
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  NONE
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum AccommodationType {
  PERSONAL
  CORPORATE
  EDUCATION
}

enum InvoiceType {
  INDIVIDUAL
  CORPORATE
}

enum UserType {
  STUDENT
  STAFF
  SPECIAL_GUEST
  PARENT
  OTHER
}

enum UserRole {
  USER
  ADMIN
  HOTEL_STAFF
}
